// The colours the window is drawn in, the icons, and the one way the window talks back to Rust.
//
// Rust sets Theme.p from the same Palette the egui window uses (src/theme.rs), so every theme -- Night, the
// Crimsons, Catppuccin, the cover's colour as the accent -- is the same colour for colour here.

export struct Palette {
    page: color,
    panel: color,
    card: color,
    raised: color,
    line: color,
    text: color,
    subtext: color,
    faint: color,
    accent: color,
    on-accent: color,
    error: color,
    light: bool,
}

export global Theme {
    in-out property <Palette> p: {
        page: #000000, panel: #07050a, card: #15101c, raised: #1d1626, line: #2a2234,
        text: #f8f4ff, subtext: #cfc5da, faint: #8f86a0, accent: #b47cff, on-accent: #12091f, error: #ff6b81,
        light: false,
    };
    /// How round corners are: Settings › Personalisation's sharp, soft or round.
    in-out property <float> corners: 1.0;
    in-out property <string> font: "";
    in-out property <bool> animations: true;
}

/// What the window asks of Rust. Every button ends here: Rust turns these into the egui window's own Actions.
export global Bridge {
    /// A plain action by name, with an argument where it needs one: ("open", "search"), ("toggle-play", "").
    callback act(string, string);
    /// A song picked from a list Rust named: ("home:2", 5), ("queue", 0), ("liked", 3).
    callback play(string, int);
    /// One of a song's menu entries: ("queue", 3, "remove").
    callback track-menu(string, int, string);
    /// Where the progress bar was clicked, from 0 to 1.
    callback seek(float);
    callback volume(float);
    callback search(string);
}

