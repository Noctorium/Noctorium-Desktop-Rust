// The pieces every page is made of: icons, buttons, covers, cards, rows of songs, headings.
// Sizes and spacing follow the egui window (src/gui/widgets.rs), which follows the Kotlin desktop.

import { Theme, Bridge, Icons } from "theme.slint";

export struct TrackItem {
    title: string,
    subtitle: string,
    duration: string,
    art: image,
    has-art: bool,
    /// The song is the one playing.
    playing: bool,
    liked: bool,
    /// The queue's own song, drawn lifted in the queue.
    current: bool,
}

export struct Shelf {
    title: string,
    subtitle: string,
    /// What Bridge.play is told the songs are, so it knows which to play.
    list: string,
    tracks: [TrackItem],
    loading: bool,
    error: string,
}

export component Icon inherits Path {
    in property <string> icon;
    in property <color> tint: Theme.p.text;
    commands: root.icon;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: root.tint;
    stroke-width: 0;
}

/// A round button with an icon, lit in the accent when its thing is on.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active;
    in property <length> size: 36px;
    in property <string> hint;
    in property <bool> enabled: true;
    out property <bool> has-hover: touch.has-hover;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: self.height / 2;
    background: touch.has-hover && root.enabled ? Theme.p.card : transparent;
    opacity: root.enabled ? 1.0 : 0.4;
    Icon {
        width: root.size * 0.58;
        height: root.size * 0.58;
        icon: root.icon;
        tint: root.active ? Theme.p.accent : (touch.has-hover ? Theme.p.text : Theme.p.subtext);
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

/// The big round play button: the text's colour, with the page's colour on it.
export component PlayButton inherits Rectangle {
    in property <bool> playing;
    in property <bool> busy;
    in property <length> size: 44px;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: self.height / 2;
    background: touch.pressed ? Theme.p.subtext : Theme.p.text;
    Icon {
        width: root.size * 0.5;
        height: root.size * 0.5;
        icon: root.playing ? Icons.pause : Icons.play;
        tint: Theme.p.page;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/// A filled button in the accent: the one thing to do on a page.
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    callback clicked();
    height: 36px;
    min-width: lay.preferred-width;
    border-radius: 18px * Theme.corners;
    background: touch.pressed ? Theme.p.accent.darker(20%) : (touch.has-hover ? Theme.p.accent.brighter(8%) : Theme.p.accent);
    lay := HorizontalLayout {
        padding-left: 16px;
        padding-right: 18px;
        spacing: 7px;
        alignment: center;
        if root.icon != "": Rectangle {
            width: 18px;
            Icon {
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                icon: root.icon;
                tint: Theme.p.on-accent;
            }
        }
        Text {
            text: root.text;
            color: Theme.p.on-accent;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/// An outlined button for everything else.
export component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    callback clicked();
    height: 34px;
    min-width: lay.preferred-width;
    border-radius: 17px * Theme.corners;
    border-width: 1px;
    border-color: root.active ? Theme.p.accent : Theme.p.line;
    background: touch.has-hover ? Theme.p.card : (root.active ? Theme.p.accent.transparentize(85%) : transparent);
    lay := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 6px;
        alignment: center;
        if root.icon != "": Rectangle {
            width: 17px;
            Icon {
                y: (parent.height - self.height) / 2;
                width: 17px;
                height: 17px;
                icon: root.icon;
                tint: root.active ? Theme.p.accent : Theme.p.text;
            }
        }
        Text {
            text: root.text;
            color: root.active ? Theme.p.accent : Theme.p.text;
            font-size: 13.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/// A cover, cut to its corners, or a note where there is none.
export component Cover inherits Rectangle {
    in property <image> art;
    in property <bool> has-art;
    in property <length> radius: 8px;
    border-radius: root.radius * Theme.corners;
    background: Theme.p.raised;
    clip: true;
    if root.has-art: Image {
        width: parent.width;
        height: parent.height;
        source: root.art;
        image-fit: cover;
    }
    if !root.has-art: Icon {
        width: min(parent.width, parent.height) * 0.36;
        height: self.width;
        icon: Icons.now-playing;
        tint: Theme.p.faint;
    }
}

/// A page's title, and what it is, under it.
export component Heading inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <length> size: 21px;
    spacing: 2px;
    Text {
        text: root.title;
        color: Theme.p.text;
        font-size: root.size;
        font-weight: 700;
        overflow: elide;
    }
    if root.subtitle != "": Text {
        text: root.subtitle;
        color: Theme.p.subtext;
        font-size: 13px;
        overflow: elide;
    }
}

export component Notice inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    border-radius: 10px * Theme.corners;
    background: root.error ? Theme.p.error.transparentize(86%) : Theme.p.card;
    border-width: 1px;
    border-color: root.error ? Theme.p.error.transparentize(55%) : Theme.p.line;
    height: t.preferred-height + 20px;
    t := Text {
        x: 14px;
        width: parent.width - 28px;
        text: root.text;
        color: root.error ? Theme.p.error : Theme.p.subtext;
        font-size: 13.5px;
        wrap: word-wrap;
    }
}

/// A square card on a shelf: the cover, the title, who it is by. Clicking it plays it.
export component Card inherits Rectangle {
    in property <TrackItem> track;
    in property <length> side: 172px;
    callback clicked();
    callback menu(length, length);
    width: root.side;
    height: root.side + 50px;
    cover := Cover {
        x: 0;
        y: 0;
        width: root.side;
        height: root.side;
        art: root.track.art;
        has-art: root.track.has-art;
        radius: 10px;
    }
    // The play button rises in the corner when the pointer is on the card.
    Rectangle {
        x: root.side - 52px;
        y: root.side - 52px;
        width: 42px;
        height: 42px;
        border-radius: 21px;
        background: Theme.p.accent;
        opacity: touch.has-hover || root.track.playing ? 1 : 0;
        animate opacity { duration: Theme.animations ? 120ms : 0ms; }
        Icon {
            width: 22px;
            height: 22px;
            icon: root.track.playing ? Icons.now-playing : Icons.play;
            tint: Theme.p.on-accent;
        }
    }
    Text {
        x: 0;
        y: root.side + 8px;
        width: root.side;
        text: root.track.title;
        color: root.track.playing ? Theme.p.accent : Theme.p.text;
        font-size: 14.5px;
        font-weight: 700;
        overflow: elide;
    }
    Text {
        x: 0;
        y: root.side + 28px;
        width: root.side;
        text: root.track.subtitle;
        color: Theme.p.subtext;
        font-size: 13px;
        overflow: elide;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

/// A row of cards that scrolls sideways, under its heading.
export component ShelfView inherits VerticalLayout {
    in property <Shelf> shelf;
    in property <length> side: 172px;
    callback menu(string, int, length, length);
    spacing: 10px;
    Heading {
        title: root.shelf.title;
        subtitle: root.shelf.subtitle;
    }
    if root.shelf.error != "": Notice {
        text: root.shelf.error;
        error: true;
    }
    if root.shelf.loading && root.shelf.error == "": Text {
        text: "Finding music…";
        color: Theme.p.faint;
        font-size: 13.5px;
    }
    if !root.shelf.loading && root.shelf.error == "": strip := Flickable {
        height: root.side + 54px;
        content-width: root.shelf.tracks.length * (root.side + 14px);
        content-height: self.height;
        for track[i] in root.shelf.tracks: Card {
            x: i * (root.side + 14px);
            y: 0;
            side: root.side;
            track: track;
            clicked => {
                Bridge.play(root.shelf.list, i);
            }
            menu(mx, my) => {
                root.menu(root.shelf.list, i, mx, my);
            }
        }
    }
}

/// One song in a list: its cover, title and artist, its length, and its menu.
export component TrackRow inherits Rectangle {
    in property <TrackItem> track;
    in property <int> index;
    in property <string> list;
    callback menu(string, int, length, length);
    height: 54px;
    border-radius: 10px * Theme.corners;
    background: touch.has-hover || more.has-hover || root.track.current ? Theme.p.card.transparentize(10%) : transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Bridge.play(root.list, root.index);
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.menu(root.list, root.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    Cover {
        x: 8px;
        y: 7px;
        width: 40px;
        height: 40px;
        radius: 6px;
        art: root.track.art;
        has-art: root.track.has-art;
    }
    if root.track.playing: Rectangle {
        x: 8px;
        y: 7px;
        width: 40px;
        height: 40px;
        border-radius: 6px * Theme.corners;
        background: #000000a0;
        Icon {
            width: 20px;
            height: 20px;
            icon: Icons.now-playing;
            tint: Theme.p.accent;
        }
    }
    Text {
        x: 60px;
        y: 8px;
        width: parent.width - 60px - 140px;
        text: root.track.title;
        color: root.track.playing ? Theme.p.accent : Theme.p.text;
        font-size: 14.5px;
        font-weight: 700;
        overflow: elide;
    }
    Text {
        x: 60px;
        y: 29px;
        width: parent.width - 60px - 140px;
        text: root.track.subtitle;
        color: Theme.p.subtext;
        font-size: 13px;
        overflow: elide;
    }
    if root.track.liked: Icon {
        x: parent.width - 124px;
        y: (parent.height - self.height) / 2;
        width: 15px;
        height: 15px;
        icon: Icons.heart;
        tint: Theme.p.accent;
    }
    Text {
        x: parent.width - 100px;
        width: 56px;
        height: parent.height;
        text: root.track.duration;
        color: Theme.p.faint;
        font-size: 13px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    more := IconButton {
        x: parent.width - 38px;
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon: Icons.more;
        opacity: touch.has-hover || self.has-hover ? 1 : 0;
        clicked => {
            root.menu(root.list, root.index, self.absolute-position.x, self.absolute-position.y + self.height);
        }
    }
}

/// A line in the rail: an icon and a page's name, lifted when it is the page open.
export component NavButton inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> lit;
    callback clicked();
    height: 38px;
    border-radius: 10px * Theme.corners;
    background: root.lit ? Theme.p.accent.transparentize(84%) : (touch.has-hover ? Theme.p.card : transparent);
    Icon {
        x: 14px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        icon: root.icon;
        tint: root.lit ? Theme.p.accent : Theme.p.text;
    }
    Text {
        x: 42px;
        height: parent.height;
        text: root.text;
        color: root.lit ? Theme.p.accent : Theme.p.text;
        font-size: 14.5px;
        font-weight: 700;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/// A thin bar that can be dragged or clicked: the song's progress, the volume.
export component Bar inherits Rectangle {
    in property <float> value;
    in property <bool> enabled: true;
    in property <length> thickness: 4px;
    in property <bool> knob: true;
    callback changed(float);
    callback released(float);
    height: 18px;
    property <float> shown: touch.pressed ? clamp(touch.mouse-x / self.width, 0, 1) : clamp(root.value, 0, 1);
    Rectangle {
        y: (parent.height - root.thickness) / 2;
        height: root.thickness;
        border-radius: root.thickness / 2;
        background: Theme.p.line;
    }
    Rectangle {
        x: 0;
        y: (parent.height - root.thickness) / 2;
        width: parent.width * root.shown;
        height: root.thickness;
        border-radius: root.thickness / 2;
        background: touch.has-hover || touch.pressed ? Theme.p.accent : Theme.p.text;
    }
    if root.knob && root.enabled && (touch.has-hover || touch.pressed): Rectangle {
        x: parent.width * root.shown - 7px;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.p.text;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        moved => {
            if (self.pressed) {
                root.changed(clamp(self.mouse-x / root.width, 0, 1));
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                root.released(clamp(self.mouse-x / root.width, 0, 1));
            }
        }
    }
}

/// A box to type in, in the theme's colours.
export component Field inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <string> icon;
    callback accepted(string);
    callback edited(string);
    public function focus-input() {
        input.focus();
    }
    height: 42px;
    border-radius: 21px * Theme.corners;
    background: Theme.p.card;
    border-width: 1px;
    border-color: input.has-focus ? Theme.p.accent : Theme.p.line;
    if root.icon != "": Icon {
        x: 14px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        icon: root.icon;
        tint: Theme.p.subtext;
    }
    input := TextInput {
        x: root.icon != "" ? 42px : 16px;
        width: parent.width - self.x - 16px;
        height: parent.height;
        color: Theme.p.text;
        selection-background-color: Theme.p.accent.transparentize(50%);
        font-size: 14.5px;
        vertical-alignment: center;
        single-line: true;
        accepted => {
            root.accepted(self.text);
        }
        edited => {
            root.edited(self.text);
        }
    }
    if input.text == "": Text {
        x: input.x;
        height: parent.height;
        text: root.placeholder;
        color: Theme.p.faint;
        font-size: 14.5px;
        vertical-alignment: center;
    }
}

/// A song's menu: what can be done with it from here.
export component TrackMenu inherits PopupWindow {
    in property <string> list;
    in property <int> index;
    in property <bool> liked;
    /// In the queue, where songs move and leave.
    in property <bool> queued;
    width: 220px;
    Rectangle {
        background: Theme.p.raised;
        border-radius: 10px * Theme.corners;
        border-width: 1px;
        border-color: Theme.p.line;
        drop-shadow-blur: 18px;
        drop-shadow-color: #00000080;
        VerticalLayout {
            padding: 6px;
            for entry in root.queued ? [
                { icon: Icons.up, text: "Move up", what: "up" },
                { icon: Icons.down, text: "Move down", what: "down" },
                { icon: Icons.close, text: "Remove from the queue", what: "remove" },
                { icon: Icons.radio, text: "Start radio", what: "radio" },
                { icon: root.liked ? Icons.heart : Icons.heart-outline, text: root.liked ? "Remove from Liked songs" : "Add to Liked songs", what: "like" },
            ] : [
                { icon: Icons.play-next, text: "Play next", what: "next" },
                { icon: Icons.add-queue, text: "Add to queue", what: "queue" },
                { icon: Icons.radio, text: "Start radio", what: "radio" },
                { icon: root.liked ? Icons.heart : Icons.heart-outline, text: root.liked ? "Remove from Liked songs" : "Add to Liked songs", what: "like" },
            ]: Rectangle {
                height: 34px;
                border-radius: 7px * Theme.corners;
                background: hover.has-hover ? Theme.p.card : transparent;
                Icon {
                    x: 10px;
                    y: (parent.height - self.height) / 2;
                    width: 17px;
                    height: 17px;
                    icon: entry.icon;
                    tint: Theme.p.subtext;
                }
                Text {
                    x: 36px;
                    height: parent.height;
                    text: entry.text;
                    color: Theme.p.text;
                    font-size: 13.5px;
                    vertical-alignment: center;
                }
                hover := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Bridge.track-menu(root.list, root.index, entry.what);
                    }
                }
            }
        }
    }
}
