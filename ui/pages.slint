// The pages: Home, Search, Library, a list of songs, the queue, Now playing and Settings.
// Each mirrors its egui counterpart in src/gui/pages.rs and src/gui/settings.rs.

import { ScrollView } from "std-widgets.slint";
import { Theme, Bridge, Icons } from "theme.slint";
import { TrackItem, Shelf, Icon, IconButton, PrimaryButton, SecondaryButton, Cover, Heading, Notice, ShelfView, TrackRow, Field } from "widgets.slint";

export struct LibraryItem {
    title: string,
    subtitle: string,
    art: image,
    has-art: bool,
    /// The page it opens, as Bridge.act("open", ...) takes it.
    page: string,
}

/// A page of songs: a playlist, Liked songs, Recently played.
export struct SongsPage {
    kind: string,
    title: string,
    detail: string,
    art: image,
    has-art: bool,
    list: string,
    tracks: [TrackItem],
    loading: bool,
    error: string,
}

export struct LyricLine {
    text: string,
    time-ms: int,
}

export struct NowPlaying {
    has-track: bool,
    title: string,
    artist: string,
    album: string,
    art: image,
    has-art: bool,
    liked: bool,
}

export struct ThemeItem {
    key: string,
    name: string,
    family: string,
    page: color,
    panel: color,
    card: color,
    text: color,
    accent: color,
    selected: bool,
}

/// A page that scrolls, with the margins every page has.
component Page inherits ScrollView {
    content-width: self.visible-width;
}

export component HomePage inherits Page {
    in property <string> greeting;
    in property <[Shelf]> shelves;
    in property <string> notice;
    in property <length> card-side: 172px;
    callback menu(string, int, length, length);
    VerticalLayout {
        alignment: start;
        padding-left: 28px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 24px;
        spacing: 18px;
        HorizontalLayout {
            Text {
                text: root.greeting;
                color: Theme.p.text;
                font-size: 30px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            SecondaryButton {
                horizontal-stretch: 0;
                icon: Icons.refresh;
                text: "Refresh";
                clicked => {
                    Bridge.act("refresh-home", "");
                }
            }
        }
        if root.notice != "": VerticalLayout {
            spacing: 10px;
            Notice {
                text: root.notice;
                error: true;
            }
            HorizontalLayout {
                alignment: start;
                PrimaryButton {
                    text: "Open Playback tools";
                    clicked => {
                        Bridge.act("open", "settings");
                    }
                }
            }
        }
        for shelf in root.shelves: ShelfView {
            shelf: shelf;
            side: root.card-side;
            menu(l, n, mx, my) => {
                root.menu(l, n, mx, my);
            }
        }
    }
}

export component SearchPage inherits Page {
    in-out property <string> query;
    in property <[Shelf]> groups;
    in property <string> hint;
    /// "music", "radio" or "artists": what the box searches.
    in property <string> kind: "music";
    callback menu(string, int, length, length);
    public function focus-box() {
        box.focus-input();
    }
    VerticalLayout {
        alignment: start;
        padding-left: 28px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 24px;
        spacing: 14px;
        Text {
            text: "Search";
            color: Theme.p.text;
            font-size: 30px;
            font-weight: 700;
        }
        box := Field {
            icon: Icons.search;
            text <=> root.query;
            placeholder: "Songs, artists, a link — !ytm, !sc or !yt for one service";
            accepted(text) => {
                Bridge.search(text);
            }
        }
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            for option in [
                { name: "music", text: "Music", icon: Icons.search },
                { name: "radio", text: "Radio", icon: Icons.radio },
                { name: "artists", text: "Artists", icon: Icons.person },
            ]: SecondaryButton {
                text: option.text;
                icon: option.icon;
                active: root.kind == option.name;
                clicked => {
                    Bridge.act("search-kind", option.name);
                }
            }
        }
        if root.hint != "": Text {
            text: root.hint;
            color: Theme.p.faint;
            font-size: 13px;
        }
        for group in root.groups: VerticalLayout {
            spacing: 6px;
            Heading {
                title: group.title;
                subtitle: group.subtitle;
                size: 18px;
            }
            if group.loading: Text {
                text: "Searching…";
                color: Theme.p.faint;
                font-size: 13.5px;
            }
            if group.error != "": Notice {
                text: group.error;
                error: true;
            }
            for track[i] in group.tracks: TrackRow {
                track: track;
                index: i;
                list: group.list;
                menu(l, n, mx, my) => {
                    root.menu(l, n, mx, my);
                }
            }
        }
    }
}

/// A big square tile on the library page.
component Tile inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> icon;
    callback clicked();
    height: 92px;
    border-radius: 14px * Theme.corners;
    background: touch.has-hover ? Theme.p.raised : Theme.p.card;
    border-width: 1px;
    border-color: Theme.p.line;
    Rectangle {
        x: 16px;
        y: (parent.height - self.height) / 2;
        width: 56px;
        height: 56px;
        border-radius: 12px * Theme.corners;
        background: Theme.p.accent.transparentize(80%);
        Icon {
            width: 28px;
            height: 28px;
            icon: root.icon;
            tint: Theme.p.accent;
        }
    }
    VerticalLayout {
        x: 88px;
        width: parent.width - 100px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.title;
            color: Theme.p.text;
            font-size: 17px;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            text: root.subtitle;
            color: Theme.p.subtext;
            font-size: 13px;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component LibraryRow inherits Rectangle {
    in property <LibraryItem> item;
    height: 60px;
    border-radius: 10px * Theme.corners;
    background: touch.has-hover ? Theme.p.card : transparent;
    Cover {
        x: 8px;
        y: 7px;
        width: 46px;
        height: 46px;
        art: root.item.art;
        has-art: root.item.has-art;
        radius: 6px;
    }
    VerticalLayout {
        x: 68px;
        width: parent.width - 80px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.item.title;
            color: Theme.p.text;
            font-size: 14.5px;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            text: root.item.subtitle;
            color: Theme.p.subtext;
            font-size: 13px;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Bridge.act("open", root.item.page);
        }
    }
}

export component LibraryPage inherits Page {
    in property <int> liked-count;
    in property <int> recent-count;
    in property <[LibraryItem]> playlists;
    in property <[LibraryItem]> followed;
    in-out property <string> new-playlist;
    VerticalLayout {
        alignment: start;
        padding-left: 28px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 24px;
        spacing: 16px;
        Text {
            text: "Library";
            color: Theme.p.text;
            font-size: 30px;
            font-weight: 700;
        }
        HorizontalLayout {
            spacing: 14px;
            Tile {
                title: "Liked songs";
                subtitle: root.liked-count == 1 ? "1 song" : root.liked-count + " songs";
                icon: Icons.heart;
                clicked => {
                    Bridge.act("open", "liked");
                }
            }
            Tile {
                title: "Recently played";
                subtitle: root.recent-count == 1 ? "1 song" : root.recent-count + " songs";
                icon: Icons.refresh;
                clicked => {
                    Bridge.act("open", "recent");
                }
            }
        }
        Heading {
            title: "Your playlists";
            subtitle: "On this computer, or Noctorium playlists on every device.";
        }
        HorizontalLayout {
            spacing: 10px;
            name := Field {
                text <=> root.new-playlist;
                placeholder: "A new playlist's name";
                accepted(text) => {
                    Bridge.act("new-playlist", text);
                    root.new-playlist = "";
                }
            }
            PrimaryButton {
                text: "Create";
                clicked => {
                    Bridge.act("new-playlist", root.new-playlist);
                    root.new-playlist = "";
                }
            }
        }
        if root.playlists.length == 0: Text {
            text: "No playlists yet: name one above.";
            color: Theme.p.faint;
            font-size: 13.5px;
        }
        for item in root.playlists: LibraryRow {
            item: item;
        }
        if root.followed.length > 0: Heading {
            title: "Followed";
            subtitle: "Playlists on the services, followed by their links.";
        }
        for item in root.followed: LibraryRow {
            item: item;
        }
    }
}


export component SongsPageView inherits Page {
    in property <SongsPage> songs;
    callback menu(string, int, length, length);
    VerticalLayout {
        alignment: start;
        padding-left: 28px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 24px;
        spacing: 18px;
        HorizontalLayout {
            spacing: 22px;
            Cover {
                width: 168px;
                height: 168px;
                radius: 12px;
                art: root.songs.art;
                has-art: root.songs.has-art;
            }
            VerticalLayout {
                alignment: end;
                spacing: 6px;
                Text {
                    text: root.songs.kind;
                    color: Theme.p.accent;
                    font-size: 12px;
                    font-weight: 700;
                    letter-spacing: 0.8px;
                }
                Text {
                    text: root.songs.title;
                    color: Theme.p.text;
                    font-size: 32px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.songs.detail;
                    color: Theme.p.subtext;
                    font-size: 13.5px;
                    overflow: elide;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 10px;
                    padding-top: 8px;
                    PrimaryButton {
                        icon: Icons.play;
                        text: "Play";
                        clicked => {
                            Bridge.act("play-all", root.songs.list);
                        }
                    }
                    SecondaryButton {
                        icon: Icons.shuffle;
                        text: "Shuffle";
                        clicked => {
                            Bridge.act("shuffle-all", root.songs.list);
                        }
                    }
                }
            }
        }
        if root.songs.loading: Text {
            text: "Reading the playlist…";
            color: Theme.p.faint;
            font-size: 13.5px;
        }
        if root.songs.error != "": Notice {
            text: root.songs.error;
            error: true;
        }
        if !root.songs.loading && root.songs.error == "" && root.songs.tracks.length == 0: Text {
            text: "No songs here yet.";
            color: Theme.p.faint;
            font-size: 13.5px;
        }
        VerticalLayout {
            spacing: 2px;
            for track[i] in root.songs.tracks: TrackRow {
                track: track;
                index: i;
                list: root.songs.list;
                menu(l, n, mx, my) => {
                    root.menu(l, n, mx, my);
                }
            }
        }
    }
}

export component QueuePage inherits Page {
    in property <[TrackItem]> tracks;
    in property <[TrackItem]> suggestions;
    in property <string> suggestions-title;
    in property <string> summary;
    callback menu(string, int, length, length);
    VerticalLayout {
        alignment: start;
        padding-left: 28px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 24px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 0;
                Text {
                    text: "Queue";
                    color: Theme.p.text;
                    font-size: 30px;
                    font-weight: 700;
                }
                Text {
                    text: root.summary;
                    color: Theme.p.subtext;
                    font-size: 13.5px;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            SecondaryButton {
                horizontal-stretch: 0;
                icon: Icons.shuffle;
                text: "Shuffle what's next";
                clicked => {
                    Bridge.act("queue-shuffle-upcoming", "");
                }
            }
            SecondaryButton {
                horizontal-stretch: 0;
                text: "Clear what's next";
                clicked => {
                    Bridge.act("queue-clear-upcoming", "");
                }
            }
            SecondaryButton {
                horizontal-stretch: 0;
                text: "Clear";
                clicked => {
                    Bridge.act("queue-clear", "");
                }
            }
        }
        if root.tracks.length == 0: Text {
            text: "The queue is empty. Play something from Home, Search or your library.";
            color: Theme.p.faint;
            font-size: 13.5px;
        }
        VerticalLayout {
            spacing: 2px;
            for track[i] in root.tracks: TrackRow {
                track: track;
                index: i;
                list: "queue";
                menu(l, n, mx, my) => {
                    root.menu(l, n, mx, my);
                }
            }
        }
        if root.suggestions.length > 0: Heading {
            title: "Autoplay";
            subtitle: root.suggestions-title;
            size: 18px;
        }
        VerticalLayout {
            spacing: 2px;
            for track[i] in root.suggestions: TrackRow {
                track: track;
                index: i;
                list: "suggestions";
                menu(l, n, mx, my) => {
                    root.menu(l, n, mx, my);
                }
            }
        }
    }
}

/// The lyrics, the line being sung lit and kept a third of the way down.
export component Lyrics inherits VerticalLayout {
    in property <[LyricLine]> lines;
    in property <bool> synced;
    in property <string> note;
    in property <int> current;
    spacing: 6px;
    if root.note != "": Text {
        text: root.note;
        color: Theme.p.faint;
        font-size: 12.5px;
        overflow: elide;
    }
    flick := Flickable {
        vertical-stretch: 1;
        content-height: column.preferred-height;
        animate content-y { duration: Theme.animations ? 320ms : 0ms; easing: ease-out; }
        column := VerticalLayout {
            // Its own width, not the content's: the words wrap to the page, and the page is not made by them.
            width: flick.width;
            spacing: 2px;
            padding-bottom: 320px;
            for line[i] in root.lines: Rectangle {
                property <bool> now: root.synced && i == root.current;
                changed now => {
                    if (self.now) {
                        flick.content-y = min(0px, max(flick.height - flick.content-height, -(self.y - flick.height / 3)));
                    }
                }
                height: words.preferred-height + 12px;
                border-radius: 8px * Theme.corners;
                background: linetouch.has-hover && root.synced ? Theme.p.card : transparent;
                words := Text {
                    x: 10px;
                    width: parent.width - 20px;
                    text: line.text == "" ? "♪" : line.text;
                    wrap: word-wrap;
                    font-size: parent.now ? 25px : 22px;
                    font-weight: 700;
                    color: parent.now ? Theme.p.text : (root.synced && i < root.current ? Theme.p.faint : Theme.p.subtext);
                    opacity: root.synced && !parent.now ? 0.7 : 1;
                    animate font-size, color { duration: Theme.animations ? 160ms : 0ms; }
                }
                linetouch := TouchArea {
                    enabled: root.synced && line.time-ms >= 0;
                    mouse-cursor: self.enabled ? pointer : default;
                    clicked => {
                        Bridge.act("seek-ms", line.time-ms);
                    }
                }
            }
        }
    }
}

export component NowPlayingPage inherits Rectangle {
    in property <NowPlaying> now;
    in property <bool> playing;
    in property <float> progress;
    in property <string> position;
    in property <string> duration;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <[TrackItem]> up-next;
    in property <[LyricLine]> lyrics;
    in property <bool> lyrics-synced;
    in property <string> lyrics-note;
    in property <int> lyric-current;
    in-out property <string> side: "next";
    callback menu(string, int, length, length);
    // The cover and what is playing on the left, Up next or the lyrics on the right, as the egui window's
    // side-by-side layout has them.
    property <length> cover-side: min(self.width * 0.42, self.height - 230px);
    if !root.now.has-track: VerticalLayout {
        alignment: center;
        spacing: 8px;
        Text {
            text: "Nothing is playing";
            color: Theme.p.text;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: "Play something from Home, Search or your library, and it shows here.";
            color: Theme.p.subtext;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }
    if root.now.has-track: HorizontalLayout {
        padding-left: 28px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 16px;
        spacing: 28px;
        VerticalLayout {
            width: root.cover-side;
            spacing: 8px;
            Cover {
                width: root.cover-side;
                height: root.cover-side;
                radius: 16px;
                art: root.now.art;
                has-art: root.now.has-art;
            }
            Rectangle {
                height: 6px;
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.now.title;
                    color: Theme.p.text;
                    font-size: 26px;
                    font-weight: 700;
                    overflow: elide;
                }
                IconButton {
                    icon: root.now.liked ? Icons.heart : Icons.heart-outline;
                    active: root.now.liked;
                    size: 34px;
                    clicked => {
                        Bridge.act("like-current", "");
                    }
                }
            }
            Text {
                text: root.now.artist;
                color: artist-touch.has-hover ? Theme.p.text : Theme.p.subtext;
                font-size: 16px;
                overflow: elide;
                artist-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Bridge.act("artist-current", "");
                    }
                }
            }
            if root.now.album != "": Text {
                text: root.now.album;
                color: Theme.p.faint;
                font-size: 13px;
                overflow: elide;
            }
            Rectangle { }
        }
        VerticalLayout {
            spacing: 10px;
            HorizontalLayout {
                alignment: start;
                spacing: 6px;
                for tab in [{ id: "next", name: "Up next" }, { id: "lyrics", name: "Lyrics" }]: Rectangle {
                    height: 30px;
                    width: label.preferred-width + 20px;
                    border-radius: 8px * Theme.corners;
                    background: root.side == tab.id ? Theme.p.accent.transparentize(80%) : (tabtouch.has-hover ? Theme.p.card : transparent);
                    label := Text {
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        text: tab.name;
                        color: root.side == tab.id ? Theme.p.accent : Theme.p.text;
                        font-size: 15px;
                        font-weight: 700;
                    }
                    tabtouch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.side = tab.id;
                            if (tab.id == "lyrics") {
                                Bridge.act("want-lyrics", "");
                            }
                        }
                    }
                }
            }
            if root.side == "next": ScrollView {
                VerticalLayout {
                    spacing: 2px;
                    alignment: start;
                    if root.up-next.length == 0: Text {
                        text: "Nothing after this song.";
                        color: Theme.p.faint;
                        font-size: 13.5px;
                    }
                    for track[i] in root.up-next: TrackRow {
                        track: track;
                        index: i;
                        list: "upnext";
                        menu(l, n, mx, my) => {
                            root.menu(l, n, mx, my);
                        }
                    }
                }
            }
            if root.side == "lyrics": Lyrics {
                lines: root.lyrics;
                synced: root.lyrics-synced;
                note: root.lyrics-note;
                current: root.lyric-current;
            }
        }
    }
}

export component SettingsPage inherits Page {
    in property <[ThemeItem]> themes;
    VerticalLayout {
        alignment: start;
        padding-left: 28px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 24px;
        spacing: 16px;
        Text {
            text: "Settings";
            color: Theme.p.text;
            font-size: 30px;
            font-weight: 700;
        }
        Notice {
            text: "This is the new Slint window, and only some of Settings has moved over so far. Everything else is still in Noctorium Rust's usual window: start it without --ui slint.";
        }
        Heading {
            title: "Theme";
            subtitle: "The same themes as every Noctorium.";
        }
        // Four to a row, as the egui window lays its swatches out.
        for row[r] in floor((root.themes.length + 3) / 4): HorizontalLayout {
            spacing: 12px;
            for cell[c] in 4: Rectangle {
                property <int> index: r * 4 + c;
                property <ThemeItem> item: index < root.themes.length ? root.themes[index] : root.themes[0];
                height: 92px;
                opacity: index < root.themes.length ? 1 : 0;
                border-radius: 12px * Theme.corners;
                background: item.page;
                border-width: item.selected ? 2px : 1px;
                border-color: item.selected ? Theme.p.accent : Theme.p.line;
                clip: true;
                Rectangle {
                    x: 12px;
                    y: 12px;
                    width: 30px;
                    height: 30px;
                    border-radius: 15px;
                    background: item.accent;
                }
                Rectangle {
                    x: 50px;
                    y: 16px;
                    width: parent.width - 62px;
                    height: 8px;
                    border-radius: 4px;
                    background: item.card;
                }
                Rectangle {
                    x: 50px;
                    y: 30px;
                    width: (parent.width - 62px) * 0.6;
                    height: 8px;
                    border-radius: 4px;
                    background: item.panel;
                }
                Text {
                    x: 12px;
                    y: 52px;
                    text: item.name;
                    color: item.text;
                    font-size: 14px;
                    font-weight: 700;
                }
                Text {
                    x: 12px;
                    y: 70px;
                    text: item.family;
                    color: item.text;
                    opacity: 0.65;
                    font-size: 11.5px;
                }
                TouchArea {
                    enabled: index < root.themes.length;
                    mouse-cursor: pointer;
                    clicked => {
                        Bridge.act("theme", item.key);
                    }
                }
            }
        }
    }
}

/// A page the Slint window does not have yet.
export component NotYetPage inherits Rectangle {
    in property <string> name;
    VerticalLayout {
        alignment: center;
        spacing: 8px;
        padding: 40px;
        Text {
            text: root.name;
            color: Theme.p.text;
            font-size: 26px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: "This page has not moved to the Slint window yet. Start Noctorium Rust without --ui slint to use it.";
            color: Theme.p.subtext;
            font-size: 14px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
